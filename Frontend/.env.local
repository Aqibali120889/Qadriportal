# VITE_API_BASE_URL — intentionally left EMPTY so API calls use relative paths
# Vite's dev server proxy (vite.config.ts) routes /api/* → http://localhost:8000
# This avoids ALL CORS issues in development.
# For production: set this to your deployed API URL (e.g. https://api.yourapp.com)
# VITE_API_BASE_URL=

# Dev user email for backend DEV_MODE bypass (Backend/.env has DEV_MODE=true)
# The backend resolves this email from the DB if no valid JWT is present.
# Change to whichever user you want to develop as:
#   cost.dev@company.local    → Cost Estimation (CE) dept
#   foundry.dev@company.local → Foundry dept
#   admin.dev@company.local   → Super Admin (sees all depts)
VITE_DEV_USER_EMAIL=cost.dev@company.local

